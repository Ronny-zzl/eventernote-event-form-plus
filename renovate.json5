{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:allNonMajor',
  ],
  timezone: 'Asia/Tokyo',
  semanticCommits: 'disabled',
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  minimumReleaseAge: '1 day',
  labels: [
    'deps',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'on the first day of the month',
    ],
  },
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: null,
    addLabels: [
      'security',
    ],
  },
  packageRules: [
    {
      description: 'Node 的 mise.toml 和 engines 一起升',
      matchPackageNames: [
        'node',
      ],
      groupName: 'node',
    },
    {
      description: 'Node / pnpm / @types/node 的大版本先在看板里批准',
      matchPackageNames: [
        'node',
        'pnpm',
        '@types/node',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      description: '小版本更新合并成一个 PR，CI 通过后自动合并',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
        'lockFileMaintenance',
      ],
      automerge: true,
      prBodyNotes: [
        'CI 通过后自动合并。',
      ],
    },
    {
      description: '构建工具单独一个 PR',
      matchPackageNames: [
        'vite',
        'vite-plugin-monkey',
      ],
      groupName: 'build tools',
      prBodyNotes: [
        '构建产物有变化时 CI 的 `git diff --exit-code eventernote-event-form-plus.user.js` 会失败，不会自动合并。',
        '这时看一下 diff（`==UserScript==` 头部、`@grant`、代码），没问题就留到下次发布时一起合并、重新构建。',
      ],
    },
    {
      description: '大版本单独开 PR，手动合并',
      matchUpdateTypes: [
        'major',
      ],
      prBodyNotes: [
        '大版本不会自动合并：看过 changelog、CI 通过后手动合并。',
      ],
    },
    {
      description: 'jsdom / playwright-core 的大版本要实跑',
      matchPackageNames: [
        'jsdom',
        '@types/jsdom',
        'playwright-core',
      ],
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        '需要实跑验证',
      ],
      prBodyNotes: [
        '**CI 绿了也不够。** jsdom 只用在 e2e 测试，playwright-core 只用在 `pnpm site login`，CI 都不跑。',
        '合并前本地跑一次 `pnpm test:e2e`（playwright-core 的话再跑 `pnpm site login`）。',
      ],
    },
  ],
}
