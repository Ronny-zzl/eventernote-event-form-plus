{
  "name": "eventernote-event-form-plus",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:e2e": "vite build && vitest run --project e2e",
    "site": "node scripts/site.ts",
    "build:preview": "vite build --mode preview",
    "preview:serve": "vite build --mode preview && vite preview"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.3"
  }
}
